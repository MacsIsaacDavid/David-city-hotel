# Local development
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Optional MySQL database. Set DB_ENABLED=true only after creating the schema.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=david_city

# Paystack TEST secret key only while using sample/demo accommodation listings.
# Get it from your Paystack dashboard. Never put secret keys in frontend files or commit .env.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Keep false until real properties, room inventory, prices, cancellation terms,
# and fulfilment arrangements have been verified and configured.
LIVE_BOOKING_ENABLED=false
